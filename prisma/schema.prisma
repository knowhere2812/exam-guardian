generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum ViolationType {
  TAB_SWITCH
  FACE_NOT_DETECTED
  MULTIPLE_FACES
  FULLSCREEN_EXIT
  AUDIO_DETECTED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(STUDENT)
  rollNumber   String?   @unique
  program      String?
  department   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  attempts     Attempt[]
  examsCreated Exam[]    @relation("ExamCreator")
}

model Exam {
  id              String      @id @default(cuid())
  title           String
  code            String      @unique
  subject         String
  instructions    String[]
  durationMinutes Int
  totalMarks      Int
  passingMarks    Int
  startsAt        DateTime?
  endsAt          DateTime?
  status          ExamStatus  @default(DRAFT)
  proctored       Boolean     @default(true)
  createdById     String
  createdBy       User        @relation("ExamCreator", fields: [createdById], references: [id])
  questions       Question[]
  attempts        Attempt[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Question {
  id          String   @id @default(cuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  text        String
  options     String[]
  correctIndex Int
  marks       Int
  difficulty  String?
  topic       String?
  answers     Answer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attempt {
  id          String        @id @default(cuid())
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id])
  studentId   String
  student     User          @relation(fields: [studentId], references: [id])
  startedAt   DateTime      @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  score       Int?
  status      AttemptStatus @default(IN_PROGRESS)
  answers     Answer[]
  sessions    ProctoringSession[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([examId, studentId])
}

model Answer {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int?
  updatedAt  DateTime @updatedAt

  @@unique([attemptId, questionId])
}

model ProctoringSession {
  id        String            @id @default(cuid())
  attemptId String
  attempt   Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  startedAt DateTime          @default(now())
  endedAt   DateTime?
  events    ProctoringEvent[]
}

model ProctoringEvent {
  id        String          @id @default(cuid())
  sessionId String
  session   ProctoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      ViolationType
  occurredAt DateTime       @default(now())
  metadata  Json?
  evidenceKey String?
}
